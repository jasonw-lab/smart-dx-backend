        <mxCell id="tenantStep1" value="1. TenantContextFilter&#xa;JWT / Header から tenant_id 解決" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;arcSize=8;fontSize=12;spacing=8;" parent="1" vertex="1">
