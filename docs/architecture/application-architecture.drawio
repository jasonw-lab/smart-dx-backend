        <mxCell id="subtitle" value="Modular Monolith: ソースはドメイン単位モジュール / デプロイは単一 fat jar（1 JVM / port 8080）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=middle;fontColor=#374151;" parent="1" vertex="1">
